APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production (Railway xs2-api service)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<your-railway-service>.up.railway.app
# DB_CONNECTION=mysql
# DB_HOST=${{MySQL.MYSQLHOST}}          # mysql.railway.internal
# DB_PORT=${{MySQL.MYSQLPORT}}          # 3306
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}  # railway
# DB_USERNAME=${{MySQL.MYSQLUSER}}      # root
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# Or: DB_URL=${{MySQL.MYSQL_URL}}
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync

# Set false to stop every scheduled cron (xs2:sync-*, SB publish/qty/order sync, sanctum prune).
# On production AWS, prefer false until you intentionally enable automation.
APP_SCHEDULER_ENABLED=false

# When true: fewer queue workers, longer cron intervals, scheduler off unless APP_SCHEDULER_ENABLED=true.
# Recommended on AWS to keep CPU under ~60%.
APP_LOW_LOAD_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is required for staging/production (legacy catalog tables + XS2 integration).
# SQLite is only suitable for isolated unit tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stagingDB
DB_USERNAME=root
DB_PASSWORD=

# --- Railway (shared hosted MySQL) ---
# Database name on Railway is `railway` (not stagingDB). Schema/data should match stagingDB.
#
# Local dev against Railway (public proxy — use from your machine):
#   DB_HOST=hopper.proxy.rlwy.net
#   DB_PORT=22841
#   DB_DATABASE=railway
#   DB_USERNAME=root
#   DB_PASSWORD=<from Railway MySQL service variables>
#
# Railway xs2-api service (private network — set in Railway dashboard, not .env):
#   DB_CONNECTION=mysql
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_DATABASE=${{MySQL.MYSQLDATABASE}}
#   DB_USERNAME=${{MySQL.MYSQLUSER}}
#   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
#
# Alternatively set DB_URL from the MySQL service (internal URL on Railway):
#   DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Shared reseller identity constraints for provider-console administrators.
PROVIDER_AUTH_STORE_ID=13
PROVIDER_AUTH_TOKEN_TTL_MINUTES=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

XS2_ENABLED=true
# Sandbox: https://testapi.xs2event.com — production: https://api.xs2event.com
XS2_BASE_URL=https://testapi.xs2event.com
XS2_API_KEY=

# XS2 sandbox test flow (admin /admin/xs2/sandbox-test only — never used by production sync)
# Prefer .env.local for XS2_SANDBOX_* secrets (bootstrap/app.php overlays .env.local after .env).
XS2_SANDBOX_API_URL=https://testapi.xs2event.com
XS2_SANDBOX_API_KEY=
# Optional: pin a specific sandbox event instead of fetching the first catalog page
# FC Barcelona vs Athletic Bilbao (Camp Nou, La Liga) — has available sandbox tickets
# XS2_SANDBOX_TEST_EVENT_ID=25a28b04f6f74203a40dccfd74134276_gnr
# XS2_SANDBOX_MAX_EVENT_ATTEMPTS=15
# XS2_SANDBOX_MAX_ORDER_QUANTITY=20
# Auto-create XS2 sandbox booking when SB orders sync (maps to sandbox-imported tickets)
# XS2_SANDBOX_AUTO_CREATE_ORDERS_FROM_SB=true
XS2_API_KEY_HEADER=X-Api-Key
XS2_EVENTS_ENDPOINT=/v1/events
XS2_EVENT_DETAIL_ENDPOINT=/v1/events/{event_id}
XS2_VENUES_ENDPOINT=/v1/venues
XS2_VENUE_DETAIL_ENDPOINT=/v1/venues/{venue_id}
XS2_TICKETS_ENDPOINT=/v1/tickets
XS2_TICKET_DETAIL_ENDPOINT=/v1/tickets/{ticket_id}
XS2_CATEGORIES_ENDPOINT=/v1/categories
XS2_CATEGORY_DETAIL_ENDPOINT=/v1/categories/{category_id}
XS2_RESERVATIONS_ENDPOINT=/v1/reservations
# Expected when XS2 exposes a supplier orders list (default stub path; override if documented).
XS2_ORDERS_ENDPOINT=/v1/orders
XS2_REQUEST_TIMEOUT=30
XS2_CONNECT_TIMEOUT=10
XS2_RETRY_TIMES=4
XS2_RETRY_DELAY_MS=1500
XS2_PAGE_SIZE=100
XS2_MAX_PAGES=500
# Application-side XS2 throttle (shared across all xs2-sync workers via cache).
# XS2 documents generous IP-based limits; 503 on abuse. Use 60 for normal ops,
# 120 for large catch-up backlogs, then lower again once queues drain.
XS2_RATE_LIMIT_PER_MINUTE=30
# Pace calls evenly across the shared cache to avoid CPU/API spikes.
XS2_RATE_LIMIT_PACING=true
# Optional: defaults to two request slots (2 seconds at 60 RPM, 4 at 30).
# XS2_INVENTORY_DISPATCH_INTERVAL_SECONDS=2
# No stagger when using xs2:sync-inventory --bulk or xs2:sync-tickets --bulk.
# XS2_BULK_IMPORT_DISPATCH_INTERVAL_SECONDS=0
# Lean parallel workers for Railway (docker-entrypoint.sh).
# Keep totals low on one web service so HTTP (/up + API) stays responsive.
# Inventory sync and Seller API (publish + qty sync) run in parallel;
# listing-gen / reconcile / mapping / guest share one aux worker.
XS2_SYNC_WORKERS=1
SELLER_API_WORKERS=1
AUX_QUEUE_WORKERS=1
# Optional local multi-worker script (scripts/run-queue-workers.sh) only:
# XS2_LISTING_GEN_WORKERS=1
# XS2_RECONCILE_WORKERS=1
# XS2_GUEST_WORKERS=1
# XS2_MAPPING_WORKERS=1
# DEFAULT_QUEUE_WORKERS=1
# QUEUE_WORKER_TRIES=5
# QUEUE_WORKER_TIMEOUT=300
# QUEUE_WORKER_SLEEP=3
# Queue backpressure — crons skip dispatch when pending jobs exceed max (per active profile).
# QUEUE_MAX_PENDING_JOBS=150
# QUEUE_MAX_DISPATCH_PER_RUN=30
XS2_SYNC_OVERLAP_MINUTES=5
XS2_FULL_SYNC_INTERVAL_MINUTES=180
XS2_EVENTS_SYNC_INTERVAL_MINUTES=60
XS2_INCREMENTAL_SYNC_INTERVAL_MINUTES=30
# Set true only if you want xs2:sync-events on an automatic schedule (default: manual via Cron Jobs → Run now).
XS2_EVENTS_SYNC_SCHEDULED=false
XS2_EVENT_SYNC_LOCK_MINUTES=10
XS2_DEFAULT_MARKUP_PERCENTAGE=10
XS2_CURRENCY_MINOR_UNIT_DIVISOR=100
XS2_QUEUE=xs2-sync
XS2_GUEST_QUEUE=xs2-guest
XS2_MAPPING_QUEUE=xs2-mapping
# XS2_MAPPING_QUEUE=xs2-mapping

# Pipeline queues (Phase 3 distributed inventory sync)
PIPELINE_STRICT=true
XS2_LISTING_GEN_QUEUE=xs2-listing-gen
XS2_RECONCILE_QUEUE=xs2-reconcile
PIPELINE_MAX_EVENTS_PER_RUN=6000
PIPELINE_DISPATCH_WINDOW_MINUTES=30
PIPELINE_RECONCILE_DELAY_SECONDS=120
PIPELINE_SLA_HOURS_BEFORE_EVENT=48
PIPELINE_STALL_MINUTES=15
PIPELINE_RETENTION_DAYS=90
# XS2_LISTING_GEN_WORKERS=1
# XS2_RECONCILE_WORKERS=1
# Legacy SB crons stay enabled during transition (pipeline is primary)
# PIPELINE_LEGACY_SB_LISTING_INVENTORY=true
# PIPELINE_LEGACY_SB_NEW_LISTING_PUBLISH=true

XS2_LOG_CHANNEL=stack
XS2_SPORTS=soccer,rugby,formula1,tennis
XS2_EVENT_AUTO_MAP_THRESHOLD=100
XS2_EVENT_PENDING_THRESHOLD=65
XS2_STADIUM_AUTO_MAP_THRESHOLD=95
XS2_STADIUM_PENDING_THRESHOLD=80
XS2_CATEGORY_AUTO_MAP_THRESHOLD=95
XS2_CATEGORY_PENDING_THRESHOLD=80
XS2_CITY_AUTO_MAP_THRESHOLD=95
XS2_COORDINATE_MATCH_RADIUS_KM=2
XS2_REQUIRE_STADIUM_DETAIL_MAPPING=true
# Master data is always read-only for this integration.
XS2_ALLOW_AUTO_CREATE_CITY=false
XS2_ALLOW_AUTO_CREATE_STADIUM=false
XS2_ALLOW_AUTO_CREATE_STADIUM_DETAIL=false
# Scheduled Seats Broker listing inventory reconcile (xs2:sync-sb-listing-inventory).
XS2_SB_LISTING_INVENTORY_SYNC_ENABLED=true
XS2_SB_LISTING_INVENTORY_SYNC_INTERVAL_MINUTES=30
# Scheduled first-time publish of new XS2 inventory on mapped events (xs2:publish-new-sb-listings).
XS2_SB_NEW_LISTING_PUBLISH_ENABLED=true
XS2_SB_NEW_LISTING_PUBLISH_INTERVAL_MINUTES=1
# Scheduled SB order import + XS2 sandbox booking creation (seller-api:sync-bookings).
SB_BOOKINGS_SYNC_ENABLED=true
SB_BOOKINGS_SYNC_INTERVAL_MINUTES=2
# Scheduled SB attendee_details → XS2 booking guest data (xs2:sync-order-guest-data).
XS2_SB_ORDER_GUEST_DATA_SYNC_ENABLED=true
XS2_SB_ORDER_GUEST_DATA_SYNC_INTERVAL_MINUTES=30
# XS2_SB_ORDER_GUEST_DATA_SYNC_BATCH_LIMIT=50
# XS2_SB_ORDER_GUEST_DATA_QUEUE=xs2-guest
# Remove all SB split listings when master stock is at or below this value.
XS2_SPLIT_LISTING_UNPUBLISH_STOCK_MAX=2
# XS2_SB_LISTING_INVENTORY_DISPATCH_INTERVAL_SECONDS=2
# XS2_SB_NEW_LISTING_PUBLISH_DISPATCH_INTERVAL_SECONDS=2

SELLER_API_ENABLED=true
# External catalog host only (no trailing /api). GET /api/events uses Bearer token below.
# Production: https://externalapi.seatsbrokers.com
# Sandbox: https://sandbox-externalapi.seatsbrokers.com
SELLER_API_BASE_URL=
# Optional per-environment catalog Bearer tokens (override SELLER_API_KEY for GET /api/events and /api/venues).
# SELLER_API_CATALOG_SANDBOX_API_KEY=
# SELLER_API_CATALOG_PRODUCTION_API_KEY=
# Multipart seller listing host (POST ticket/create, ticket_dropdown, …). NOT externalapi — those routes 404 there.
# Production: https://sellerapi.seatsbrokers.com — Sandbox: https://sandbox-sellerapi.seatsbrokers.com
SELLER_API_LISTING_BASE_URL=https://sandbox-sellerapi.seatsbrokers.com
# External catalog Bearer token (64-char hex). Listing calls use SELLER_API_LISTING_API_KEY when set, else this key in the apiKey header.
SELLER_API_KEY=
# Seller Sanctum key for listing multipart API (apiKey header). Required in production when SELLER_API_KEY is only the external catalog Bearer token.
SELLER_API_LISTING_API_KEY=
SELLER_API_AUTH_TYPE=api_key
SELLER_API_KEY_HEADER=apiKey
SELLER_API_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
SELLER_API_SELLER_ID=
SELLER_API_EVENTS_ENDPOINT=/api/events
SELLER_API_VENUES_ENDPOINT=/api/venues
SELLER_API_TOURNAMENTS_ENDPOINT=/api/tournaments
SELLER_API_CATALOG_PER_PAGE=100
# Listing multipart routes on SELLER_API_LISTING_BASE_URL (defaults apply when unset).
SELLER_API_CREATE_LISTING_ENDPOINT=/api/ticket/create
SELLER_API_UPDATE_LISTING_ENDPOINT=/api/ticket/edit
SELLER_API_DISABLE_LISTING_ENDPOINT=/api/ticket/update_status
SELLER_API_DELETE_LISTING_ENDPOINT=/api/ticket/delete
SELLER_API_GET_LISTING_ENDPOINT=/api/ticket
# Optional recovery lookup after ambiguous create timeouts.
# SELLER_API_FIND_LISTING_ENDPOINT=
SELLER_API_TICKET_DROPDOWN_ENDPOINT=/api/ticket_dropdown
SELLER_API_BOOKING_ENDPOINT=/api/booking
SELLER_API_REQUEST_TIMEOUT=30
SELLER_API_CONNECT_TIMEOUT=10
SELLER_API_RETRY_TIMES=3
SELLER_API_RETRY_DELAY_MS=1000
SELLER_API_QUEUE=seller-api
# false = major-unit decimals per Seatsbrokers External Seller API (price=118 for €118). true = send XS2 minor integers unchanged.
SELLER_API_PRICE_USES_MINOR_UNITS=false
SELLER_API_EXTERNAL_REFERENCE_PREFIX=XS2-
SELLER_API_LOG_CHANNEL=stack

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
